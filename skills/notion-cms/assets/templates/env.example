# Runtime — used by Next.js server code
NOTION_TOKEN=secret_your_integration_token
NOTION_BLOG_DATABASE_ID=your-database-uuid-with-dashes

# Optional — include isPublished=false entries in dev
# SHOW_UNPUBLISHED=true

# notion-ts-client CLI — used by pnpm notion:generate
NOTION_TS_CLIENT_NOTION_SECRET=secret_your_integration_token
NOTION_TS_CLIENT_CONFIG_PATH=./notion-sdk.json
NOTION_TS_CLIENT_SDK_PATH=./notion-sdk
